
{
  "entities": {
    "Request": {
      "title": "Access Request",
      "description": "User request for intelligence scan access.",
      "type": "object",
      "properties": {
        "requestId": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "paymentStatus": { "type": "string", "enum": ["pending", "paid"] },
        "status": { "type": "string", "enum": ["pending", "approved", "declined"] },
        "createdAt": { "type": "number" },
        "used": { "type": "boolean" }
      },
      "required": ["requestId", "status", "createdAt", "used"]
    },
    "SystemConfig": {
      "title": "System Configuration",
      "description": "Global passwords and system-wide settings.",
      "type": "object",
      "properties": {
        "adminPassword": { "type": "string" },
        "sitePassword": { "type": "string" }
      },
      "required": ["adminPassword", "sitePassword"]
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/requests/{requestId}": {
      "schema": "Request",
      "description": "Intelligence access requests."
    },
    "/config/system": {
      "schema": "SystemConfig",
      "description": "Master system credentials."
    }
  }
}
