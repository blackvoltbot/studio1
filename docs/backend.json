{
  "entities": {
    "User": {
      "title": "User Account",
      "description": "User profile with coin balance and credentials.",
      "type": "object",
      "properties": {
        "phoneNumber": { "type": "string" },
        "password": { "type": "string" },
        "coins": { "type": "number", "default": 0 },
        "createdAt": { "type": "number" }
      },
      "required": ["phoneNumber", "password", "coins", "createdAt"]
    },
    "Transaction": {
      "title": "Coin Transaction",
      "description": "Request for coin purchase.",
      "type": "object",
      "properties": {
        "transactionId": { "type": "string" },
        "userPhone": { "type": "string" },
        "amount": { "type": "number" },
        "coins": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "approved", "declined"] },
        "createdAt": { "type": "number" }
      },
      "required": ["transactionId", "userPhone", "amount", "coins", "status", "createdAt"]
    },
    "SystemConfig": {
      "title": "System Configuration",
      "description": "Master credentials for admin and global settings.",
      "type": "object",
      "properties": {
        "adminPassword": { "type": "string" }
      },
      "required": ["adminPassword"]
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/users/{phone}": {
      "schema": "User",
      "description": "User accounts keyed by phone number."
    },
    "/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Coin purchase requests."
    },
    "/config/system": {
      "schema": "SystemConfig",
      "description": "Master system credentials."
    }
  }
}